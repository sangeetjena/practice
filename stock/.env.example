STOCK_ENVIRONMENT=local
STOCK_EXECUTION_MODE=paper
# Configure after starting INFRA's PostgreSQL port-forward; use its local credentials.
# STOCK_DATABASE_URL=postgresql+asyncpg://postgres:<password>@127.0.0.1:5432/agentdb
# Redis is not deployed by the current INFRA platform.
# STOCK_REDIS_URL=redis://127.0.0.1:6379/0
STOCK_LOG_LEVEL=INFO
# Set only when adding a licensed provider or model adapter:
# STOCK_MARKET_DATA_API_KEY=
# STOCK_NEWS_API_KEY=
# STOCK_LLM_API_KEY=
