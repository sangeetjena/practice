STOCK_ENVIRONMENT=local
STOCK_EXECUTION_MODE=paper
# Populate from INFRA/.env after running its local port-forwards. URL-encode special
# characters in passwords. asyncpg uses postgresql:// (without +asyncpg).
# STOCK_DATABASE_URL=postgresql://postgres:<postgres-password>@127.0.0.1:5432/agentdb
# STOCK_TIMESCALE_URL=postgresql://postgres:<timescale-password>@127.0.0.1:5433/stock
# STOCK_REDIS_URL=redis://:<redis-password>@127.0.0.1:6379/0
# STOCK_QDRANT_URL=http://127.0.0.1:6333
# STOCK_QDRANT_API_KEY=<qdrant-api-key>
STOCK_ALPHA_VANTAGE_INTRADAY_ENABLED=false
STOCK_ALPHA_VANTAGE_EXCHANGE_TIMEZONE=America/New_York
STOCK_ALPHA_VANTAGE_FULL_HISTORY_ENABLED=false
STOCK_ALPHA_VANTAGE_INTERVAL=5min
STOCK_ALPHA_VANTAGE_POLL_SECONDS=300
# STOCK_ALPHA_VANTAGE_API_KEY=<your-provider-key>
STOCK_LOG_LEVEL=INFO
STOCK_MODEL_URL=http://127.0.0.1:8000
STOCK_MODEL_TOKEN=CHANGE_ME
# Set only when adding a model adapter:
# STOCK_LLM_API_KEY=
