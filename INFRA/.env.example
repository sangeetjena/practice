# Copy to .env and replace the local-only credentials before first deployment.
INFRA_DATA_DIR=./data
POSTGRES_PASSWORD=replace-with-a-local-password
CASSANDRA_PASSWORD=replace-with-a-local-password
QDRANT_API_KEY=replace-with-a-local-api-key
TIMESCALE_PASSWORD=replace-with-a-local-password
REDIS_PASSWORD=replace-with-a-local-password

POSTGRES_LOCAL_PORT=5432
CASSANDRA_LOCAL_PORT=9042
QDRANT_HTTP_LOCAL_PORT=6333
QDRANT_GRPC_LOCAL_PORT=6334
TIMESCALE_LOCAL_PORT=5433
REDIS_LOCAL_PORT=6379

# Optional local monitoring; histories/dashboards are disposable.
ENABLE_MONITORING=false
GRAFANA_PASSWORD=
GRAFANA_LOCAL_PORT=3000
PROMETHEUS_LOCAL_PORT=9090
