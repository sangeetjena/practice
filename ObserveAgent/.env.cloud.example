# Copy to .env.cloud after creating strong credentials. Docker Compose loads this file explicitly.
# Never commit the resulting file or any real keys.
POSTGRES_PASSWORD=replace-with-a-random-local-password
DATABASE_URL=postgresql+psycopg://observer:replace-with-a-random-local-password@postgres:5432/observer
# Replace the sha256 with the SHA-256 hex digest of your generated API key.
OBSERVE_AUTH_KEYS=[{"sha256":"REPLACE_WITH_64_CHARACTER_SHA256","tenant_id":"acme","subject":"local-owner","roles":["read","submit","review"]}]
OBSERVE_TENANTS={"acme":{"services":["orders"],"prometheus_url":"http://host.docker.internal:9090","action_allowlist":[],"http_allowed_hosts":[],"github_allowed_repositories":[],"email_allowed_recipients":[]}}
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_SSL=false
EMBEDDING_PROVIDER=hash
LLM_PROVIDER=rule
ACTION_MODE=dry_run
